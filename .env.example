# Copy to .env before running docker compose. The .env file is git-ignored.

# Signing key for JWT access tokens (at least 32 characters). Generate your own:
#   openssl rand -base64 48
JWT_KEY=replace-me-with-a-long-random-string-before-deploying

# Database password used by both the postgres and api containers.
POSTGRES_PASSWORD=taskflow

# Optional: set a password to also seed an admin account (admin@taskflow.dev).
SEED_ADMIN_PASSWORD=
