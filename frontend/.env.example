# Base URL prepended to every API request ("/api/..." is appended by the app).
# Leave empty in development: requests stay relative and go through the Vite proxy.
# Set it when the API is served from a different origin, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev/preview server only: where Vite proxies "/api" to (the ASP.NET Core API).
# Defaults to http://localhost:5080
VITE_PROXY_TARGET=http://localhost:5080
